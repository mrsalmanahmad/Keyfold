{
  "name": "keyfold",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge team password manager — Chrome extension backed by Google Drive.",
  "license": "MIT",
  "author": "Salman Ahmad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsalmanahmad/Keyfold.git"
  },
  "bugs": {
    "url": "https://github.com/mrsalmanahmad/Keyfold/issues"
  },
  "homepage": "https://github.com/mrsalmanahmad/Keyfold#readme",
  "keywords": [
    "password-manager",
    "chrome-extension",
    "end-to-end-encryption",
    "google-drive",
    "zero-knowledge"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "zip": "npm run build && node scripts/zip-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "hash-wasm": "^4.11.0",
    "libsodium-wrappers": "0.7.15",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^6.1.86",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
